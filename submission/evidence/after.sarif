              "id": "CVE-2022-2564_mongoose_5.0.0",
              "name": "CVE-2022-2564-mongoose-5.0.0",
              "properties": {
                "impactPaths": [
                  [
                    {
                      "id": "npm://user-management-service:1.0.0",
                      "name": "user-management-service",
                      "version": "1.0.0"
